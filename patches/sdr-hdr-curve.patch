+/* Five reference-white knots at GNOME slider percentages 0/25/50/75/100.
+ * Ref-white backlights expose raw 10..210, not a percentage itself. */
+static double
+get_sdr_curve_white (MetaColorDevice *device)
+{
+  const MetaMonitorSpec *spec = meta_monitor_get_spec (device->monitor);
+  g_autoptr (GVariant) profiles =
+    g_settings_get_value (device->sdr_correction_settings, "sdr-hdr-brightness-curves");
+
+  for (gsize i = 0; i < g_variant_n_children (profiles); i++)
+    {
+      g_autoptr (GVariant) entry = g_variant_get_child_value (profiles, i);
+      g_autoptr (GVariant) values = NULL;
+      const char *connector, *vendor, *product, *serial;
+      const double *data;
+      gsize count;
+      double white;
+      g_variant_get (entry, "(&s&s&s&s@ad)", &connector, &vendor, &product, &serial, &values);
+      if (g_strcmp0 (connector, spec->connector) != 0 ||
+          g_strcmp0 (vendor, spec->vendor) != 0 ||
+          g_strcmp0 (product, spec->product) != 0 ||
+          g_strcmp0 (serial, spec->serial) != 0)
+        continue;
+      data = g_variant_get_fixed_array (values, &count, sizeof (double));
+      white = meta_sdr_curve_white (data, count, device->reference_luminance_factor);
+      if (white > 0) return white;
+    }
+  return 0;
+}
