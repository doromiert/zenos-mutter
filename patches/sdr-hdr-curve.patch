diff --git a/src/backends/meta-sdr-brightness-curve.h b/src/backends/meta-sdr-brightness-curve.h
--- /dev/null
+++ b/src/backends/meta-sdr-brightness-curve.h
@@ -0,0 +1,18 @@
+/* Optional SDR reference-white interpolation; zero means invalid/disabled. */
+#pragma once
+#include <math.h>
+#include <stddef.h>
+
+static inline double
+meta_sdr_curve_white (const double *points, size_t count, double factor)
+{
+  double position;
+  int segment;
+  if (count != 5 || !isfinite (factor)) return 0;
+  for (size_t i = 0; i < count; i++)
+    if (!isfinite (points[i]) || points[i] < 1 || points[i] > 1000 ||
+        (i && points[i] < points[i - 1])) return 0;
+  position = fmin (4, fmax (0, (factor - .1) * 2));
+  segment = (int) fmin (3, position);
+  return points[segment] + (points[segment + 1] - points[segment]) * (position - segment);
+}
