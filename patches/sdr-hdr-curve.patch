 }
+
+/* Called after global grading, while constructing a new output state. */
+void
+clutter_color_state_params_set_sdr_white (ClutterColorState *state,
+                                         float              white)
+{
+  ClutterColorStateParams *params = CLUTTER_COLOR_STATE_PARAMS (state);
+  g_return_if_fail (isfinite (white) && white >= 1 && white <= 1000);
+  if (!params->sdr_grading_enabled)
+    {
+      const float neutral[10] = { 0, 1, 1 / params->sdr_gamma,
+                                 params->sdr_saturation, 0, 1, 1, 1, 203, 0 };
+      clutter_color_state_params_set_sdr_grading (state, neutral);
+    }
+  /* Existing profile values stay intact; only SDR's normalization changes.
+   * Native HDR skips this operation, including through the blend state. */
+  params->sdr_grading_reference =
+    clutter_eotf_get_default_luminance (params->eotf)->ref *
+    params->sdr_grading[8] / white;
+}
