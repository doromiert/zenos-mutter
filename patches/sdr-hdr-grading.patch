+static void
+apply_sdr_grading_rgb (float rgb[4], const float p[10], float reference_white)
+{
+  float luminance, u, v, angle, rotated_u, rotated_v;
+  for (int c = 0; c < 3; c++)
+    {
+      float x = MAX (rgb[c], 0.0f);
+      float encoded = x <= 0.0031308f ? x * 12.92f : 1.055f * powf (x, 1.0f / 2.4f) - 0.055f;
+      float shadows = 1.0f - CLAMP (encoded, 0.0f, 1.0f);
+      encoded = CLAMP ((encoded - 0.5f) * p[1] + 0.5f + p[4] * shadows * shadows, 0.0f, 1.0f);
+      encoded = powf (encoded, 1.0f / p[2]);
+      rgb[c] = (encoded <= 0.04045f ? encoded / 12.92f : powf ((encoded + 0.055f) / 1.055f, 2.4f)) *
+               exp2f (p[0]) * p[5 + c];
+    }
+  luminance = 0.2126f * rgb[0] + 0.7152f * rgb[1] + 0.0722f * rgb[2];
+  for (int c = 0; c < 3; c++)
+    rgb[c] = luminance + (rgb[c] - luminance) * p[3];
+  u = (rgb[2] - luminance) / 1.8556f;
+  v = (rgb[0] - luminance) / 1.5748f;
+  angle = p[9] * 0.01745329252f;
+  rotated_u = u * cosf (angle) - v * sinf (angle);
+  rotated_v = u * sinf (angle) + v * cosf (angle);
+  rgb[0] = luminance + 1.5748f * rotated_v;
+  rgb[2] = luminance + 1.8556f * rotated_u;
+  rgb[1] = (luminance - 0.2126f * rgb[0] - 0.0722f * rgb[2]) / 0.7152f;
+  for (int c = 0; c < 3; c++)
+    rgb[c] *= p[8] / reference_white;
+}
