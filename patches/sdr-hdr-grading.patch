+
+/* Values follow Color Compare: EV, contrast, gamma, saturation, shadows,
+ * RGB gains, SDR white nits and hue degrees. HDR intermediates bypass grading. */
+void
+clutter_color_state_params_set_sdr_grading (ClutterColorState *state,
+                                          const float values[10])
+{
+  static const float lower[10] = { -2, .5, .5, 0, -.2, .5, .5, .5, 80, -45 };
+  static const float upper[10] = { 2, 2, 2, 2, .2, 1.5, 1.5, 1.5, 400, 45 };
+  ClutterColorStateParams *params;
+
+  g_return_if_fail (CLUTTER_IS_COLOR_STATE_PARAMS (state));
+  g_return_if_fail (values != NULL);
+  for (int i = 0; i < 10; i++)
+    g_return_if_fail (isfinite (values[i]) && values[i] >= lower[i] && values[i] <= upper[i]);
+  params = CLUTTER_COLOR_STATE_PARAMS (state);
+  memcpy (params->sdr_grading, values, sizeof params->sdr_grading);
+  params->sdr_grading_reference =
+    clutter_color_state_params_get_luminance (params)->ref;
+  params->sdr_grading_enabled = TRUE;
+}
