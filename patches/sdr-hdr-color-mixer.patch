+static float
+mixer_smoothstep (float low, float high, float value)
+{
+  float t = CLAMP ((value - low) / (high - low), 0.0f, 1.0f);
+  return t * t * (3.0f - 2.0f * t);
+}
+
+static void
+apply_sdr_mixer_rgb (float rgb[4], const float original[3], const float p[18])
+{
+  float encoded[3], hi, lo, delta, saturation, mask, hue;
+  float adjustment[3] = { 0 };
+  float y, u, v, angle, ru, rv;
+  for (int c = 0; c < 3; c++)
+    {
+      float x = MAX (original[c], 0.0f);
+      encoded[c] = CLAMP (x <= 0.0031308f ? x * 12.92f :
+                          1.055f * powf (x, 1.0f / 2.4f) - 0.055f, 0.0f, 1.0f);
+    }
+  hi = MAX (MAX (encoded[0], encoded[1]), encoded[2]);
+  lo = MIN (MIN (encoded[0], encoded[1]), encoded[2]);
+  delta = hi - lo;
+  saturation = hi > 0 ? delta / hi : 0;
+  mask = mixer_smoothstep (0.02f, 0.15f, saturation);
+  if (mask == 0)
+    return;
+  hue = hi == encoded[0] ? (encoded[1] - encoded[2]) / delta :
+        hi == encoded[1] ? 2 + (encoded[2] - encoded[0]) / delta :
+                          4 + (encoded[0] - encoded[1]) / delta;
+  if (hue < 0) hue += 6;
+  for (int band = 0; band < 6; band++)
+    {
+      float distance = fabsf (hue - band);
+      float weight;
+      distance = MIN (distance, 6 - distance);
+      weight = mixer_smoothstep (0, 1, CLAMP (1 - distance, 0.0f, 1.0f));
+      adjustment[0] += weight * p[3 * band];
+      adjustment[1] += weight * (p[3 * band + 1] - 1);
+      adjustment[2] += weight * p[3 * band + 2];
+    }
+  for (int c = 0; c < 3; c++) adjustment[c] *= mask;
+  y = 0.2126f * rgb[0] + 0.7152f * rgb[1] + 0.0722f * rgb[2];
+  u = (rgb[2] - y) / 1.8556f;
+  v = (rgb[0] - y) / 1.5748f;
+  angle = adjustment[0] * 0.01745329252f;
+  ru = (u * cosf (angle) - v * sinf (angle)) * (1 + adjustment[1]);
+  rv = (u * sinf (angle) + v * cosf (angle)) * (1 + adjustment[1]);
+  rgb[0] = y + 1.5748f * rv;
+  rgb[2] = y + 1.8556f * ru;
+  rgb[1] = (y - 0.2126f * rgb[0] - 0.0722f * rgb[2]) / 0.7152f;
+  for (int c = 0; c < 3; c++) rgb[c] *= exp2f (adjustment[2]);
+}
