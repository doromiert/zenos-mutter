+
+/* Six cyclic bands: red/yellow/green/cyan/blue/magenta, hue/saturation/EV. */
+void
+clutter_color_state_params_set_sdr_mixer (ClutterColorState *state,
+                                        const float values[18])
+{
+  const float lower[3] = { -30, 0, -1 };
+  const float upper[3] = { 30, 2, 1 };
+  const float neutral[3] = { 0, 1, 0 };
+  ClutterColorStateParams *params;
+  gboolean enabled = FALSE;
+  g_return_if_fail (CLUTTER_IS_COLOR_STATE_PARAMS (state));
+  g_return_if_fail (values != NULL);
+  for (int i = 0; i < 18; i++)
+    {
+      g_return_if_fail (isfinite (values[i]) && values[i] >= lower[i % 3] && values[i] <= upper[i % 3]);
+      enabled |= values[i] != neutral[i % 3];
+    }
+  params = CLUTTER_COLOR_STATE_PARAMS (state);
+  memcpy (params->sdr_mixer, values, sizeof params->sdr_mixer);
+  params->sdr_mixer_enabled = enabled;
+}
