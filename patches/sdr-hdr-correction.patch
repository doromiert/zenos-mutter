  *
  * Applies the tone mapping to the given #ClutterColorState
  */
+static void
+apply_sdr_correction_xyz (ClutterColorStateParams *source,
+                          ClutterColorStateParams *target,
+                          float *data, int n_samples)
+{
+  graphene_matrix_t from_xyz, to_xyz;
+  int i, channel;
+
+  clutter_color_state_params_get_from_XYZ (source, &from_xyz);
+  clutter_color_state_params_get_to_XYZ (source, &to_xyz);
+  for (i = 0; i < n_samples; i++)
+    {
+      graphene_vec4_t v;
+      float rgb[4] = { data[0], data[1], data[2], 1.0f };
+      float peak;
+      graphene_vec4_init_from_float (&v, rgb);
+      graphene_matrix_transform_vec4 (&from_xyz, &v, &v);
+      graphene_vec4_to_float (&v, rgb);
+      for (channel = 0; channel < 3; channel++)
+        rgb[channel] = powf (MAX (rgb[channel], 0.0f), target->sdr_gamma);
+      peak = MAX (MAX (rgb[0], rgb[1]), rgb[2]);
+      for (channel = 0; channel < 3; channel++)
+        rgb[channel] = CLAMP (peak + (rgb[channel] - peak) * target->sdr_saturation, 0.0f, 1.0f);
+      graphene_vec4_init_from_float (&v, rgb);
+      graphene_matrix_transform_vec4 (&to_xyz, &v, &v);
+      graphene_vec4_to_float (&v, rgb);
+      for (channel = 0; channel < 3; channel++) data[channel] = rgb[channel];
+      data += 3;
+    }
+}
