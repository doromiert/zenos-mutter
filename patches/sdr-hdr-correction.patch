+/* Set only while constructing a new output/blending color state. */
+void
+clutter_color_state_params_set_sdr_correction (ClutterColorState *state,
+                                               float gamma,
+                                               float saturation)
+{
+  ClutterColorStateParams *params = CLUTTER_COLOR_STATE_PARAMS (state);
+  g_return_if_fail (isfinite (gamma) && gamma >= 0.5f && gamma <= 2.0f);
+  g_return_if_fail (isfinite (saturation) && saturation >= 0.0f && saturation <= 2.0f);
+  params->sdr_gamma = gamma;
+  params->sdr_saturation = saturation;
+}
