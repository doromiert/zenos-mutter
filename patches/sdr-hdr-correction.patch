+/* HDR blending buffers use a gamma transfer function too. Mastering headroom,
+ * not the transfer-function name, distinguishes them from SDR source content. */
+static gboolean
+needs_sdr_correction (ClutterColorStateParams *source,
+                      ClutterColorStateParams *target)
+{
+  ClutterColorimetry srgb = { .type = CLUTTER_COLORIMETRY_TYPE_COLORSPACE,
+                             .colorspace = CLUTTER_COLORSPACE_SRGB };
+  const ClutterLuminance *lum = clutter_color_state_params_get_luminance (source);
+
+  return (target->sdr_gamma != 1.0f || target->sdr_saturation != 1.0f) &&
+         !(source->eotf.type == CLUTTER_EOTF_TYPE_NAMED &&
+           source->eotf.tf_name == CLUTTER_TRANSFER_FUNCTION_PQ) &&
+         lum->mastering_max <= lum->ref * 1.01f &&
+         colorimetry_equal (&source->colorimetry, &srgb);
+}
