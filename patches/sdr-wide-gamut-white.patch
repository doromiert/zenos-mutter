     {
+      cogl_pipeline_set_uniform_1f (pipeline,
+        cogl_pipeline_get_uniform_location (pipeline, "sdr_white_only"),
+        sdr_white_only_scale (color_state_params, target_color_state_params));
       int gamma_location = cogl_pipeline_get_uniform_location (pipeline, "sdr_gamma");
       int saturation_location = cogl_pipeline_get_uniform_location (pipeline, "sdr_saturation");
       cogl_pipeline_set_uniform_1f (pipeline, gamma_location, target_color_state_params->sdr_gamma);
@@ -2255,6 +2277,14 @@
 {
