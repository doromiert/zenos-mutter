     clutter_color_state_params_set_sdr_grading (corrected, saved_profile);
   else
     clutter_color_state_params_set_sdr_correction (corrected, 1.4f, 1.3f);
-  if (advanced == 2)
+  if (advanced >= 2)
     {
       float mixer[18];
